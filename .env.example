DATABASE_URL="postgresql://user:password@host:5432/codemap"
# Neon: unpooled URL for prisma migrate deploy on Vercel (optional but recommended)
DIRECT_URL=""
GITHUB_TOKEN=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
PINECONE_API_KEY=""
PINECONE_INDEX_NAME="codemap"

# ---------------------------------------------------------------------------
# AI Provider configuration
#
# AI_PROVIDER selects the LLM backend. Priority when omitted:
#   1. ANTHROPIC_API_KEY set  → anthropic
#   2. OPENAI_API_KEY set     → openai
#   3. fallback               → ollama (no key required, runs locally)
#
# Options:
#   anthropic  — Anthropic Claude via @anthropic-ai/sdk
#                Default model: claude-sonnet-4-5
#                Requires: ANTHROPIC_API_KEY
#
#   openai     — OpenAI via openai package
#                Default model: gpt-4o-mini
#                Requires: OPENAI_API_KEY
#
#   ollama     — Local models via Ollama's OpenAI-compatible endpoint
#                Default model: llama3.2
#                No API key required. Install Ollama: https://ollama.com
#                Run: ollama pull llama3.2 && ollama serve
# ---------------------------------------------------------------------------
AI_PROVIDER="ollama"
AI_MODEL="llama3.2"

# Max source files to fetch/parse per repo (priority extensions first when capped)
MAX_FILES="500"

# CodeMap Lite — GitHub tree API only (no zip)
MAX_LITE_TREE_PATHS="400"
MAX_LITE_FILES="36"

# Content-hash skip cache: unchanged files skip re-parse and cached AI summaries
# on re-analysis (SHA256 stored on FileNode.contentHash)
